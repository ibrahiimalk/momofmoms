{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "momofmoms",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "momofmoms-db",
      "database_id": "e8da22ca-e950-4c2c-892c-aa49e477d845",
      "remote": true
    }
  ],
  "r2_buckets": [
    {
      "binding": "IMAGES",
      "bucket_name": "momofmoms-images",
      "remote": true
    }
  ],
  "vars": {
    "ADMIN_EMAIL": "mom.of.momsq8@gmail.com,ibrahiim.alk@gmail.com"
  }
}
